---
import { club, nav } from '../lib/data.js';
const { title, description = `${club.full} : actualités, calendrier, résultats et photos.` } = Astro.props;
const path = Astro.url.pathname;
const on = (h) => (h === '/' ? path === '/' : path.startsWith(h)) ? 'on' : '';
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} · {club.name}</title><meta name="description" content={description}>
<meta property="og:title" content={`${title} · ${club.name}`}><meta property="og:description" content={description}><link rel="icon" href="/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{--red:#C8102E;--ink:#14141A;--bg:#fff;--card:#F6F4F2;--line:#E4E0DC;--muted:#5F5F67}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font:16px/1.55 Barlow,system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit}h1,h2,h3{font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;line-height:1;margin:0 0 .6em;letter-spacing:.01em}
h1{font-size:clamp(2.4rem,6vw,4rem)}h2{font-size:clamp(1.6rem,3vw,2.2rem)}
header.bar{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:2px solid var(--red)}
.bar .in{max-width:1200px;margin:auto;display:flex;align-items:center;gap:20px;padding:8px 20px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font:800 1.5rem 'Barlow Condensed';letter-spacing:.04em}
.brand img{width:48px;height:48px;object-fit:contain;background:#fff;border:1px solid var(--line);border-radius:10px;padding:3px}
.bar nav{margin-left:auto;display:flex;gap:2px}.bar nav a{padding:12px 14px;text-decoration:none;font-weight:600;text-transform:uppercase;font-size:.9rem;letter-spacing:.05em;border-bottom:3px solid transparent}
.bar nav a:hover,.bar nav a.on{border-color:var(--red)}.burger{display:none;margin-left:auto}
.burger summary{list-style:none;cursor:pointer;background:var(--red);padding:10px 16px;border-radius:8px;font-weight:700}
.burger nav{position:absolute;left:0;right:0;top:100%;background:#fff;border-bottom:1px solid var(--line);display:flex;flex-direction:column;padding:8px 20px}
.wrap{max-width:1200px;margin:auto;padding:36px 20px}
.hero{background:#fff;border-bottom:1px solid var(--line)}
.hero .wrap{display:grid;grid-template-columns:1fr 1.25fr;gap:40px;align-items:center;padding:48px 20px 120px}.hero p{max-width:480px;color:var(--muted);font-size:1.15rem}.hero img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:14px;box-shadow:0 20px 44px rgba(0,0,0,.18)}
.kicker,.badge{display:inline-block;background:var(--red);color:#fff;border-radius:4px;padding:3px 10px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.btn{display:inline-block;background:var(--red);color:#fff;border-radius:6px;padding:13px 22px;text-decoration:none;font-weight:700;text-transform:uppercase;letter-spacing:.05em;border:0;cursor:pointer;font:inherit;font-weight:700}
.btn.ghost{background:transparent;color:var(--red);border:2px solid var(--red);margin-left:8px}.btn:hover{filter:brightness(1.15)}
.mc{margin:-90px auto 0;position:relative;z-index:2;max-width:1200px;padding:0 20px}
.mc .box{background:var(--card);border:1px solid var(--line);border-top:4px solid var(--red);box-shadow:0 14px 40px rgba(0,0,0,.12);border-radius:12px;padding:24px;display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;text-align:center}
.vs{display:flex;align-items:center;justify-content:center;gap:20px;font:800 2rem 'Barlow Condensed'}
.logo{width:72px;height:72px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;color:#888;font-size:1.6rem;overflow:hidden}.logo img{width:64px;height:64px;object-fit:contain}
.cd{display:flex;gap:10px;justify-content:center}.cd div{background:var(--red);color:#fff;border-radius:8px;padding:8px 12px;min-width:62px}.cd b{display:block;font:800 1.8rem 'Barlow Condensed'}.cd span{font-size:.7rem;color:#ffd9de;text-transform:uppercase}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin:0 0 12px}.muted{color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}.news{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
.n{position:relative;min-height:240px;border-radius:12px;overflow:hidden;background-size:cover;background-position:center;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:18px;text-decoration:none;border:1px solid var(--line);transition:transform .25s}.n:hover{transform:translateY(-4px)}
.n h3{font-size:1.6rem;margin:8px 0 0}.tile{display:block;padding:22px 18px;background:var(--card);border:1px solid var(--line);border-left:5px solid var(--red);border-radius:8px;text-decoration:none;font:700 1.4rem 'Barlow Condensed';text-transform:uppercase;transition:background .2s}.tile:hover{background:var(--red);color:#fff}
.cta{background:linear-gradient(rgba(200,16,46,.88),rgba(200,16,46,.88)),url(/terrain.jpg) center/cover;color:#fff;text-align:center}.cta .btn{background:#fff;color:var(--red)}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:8px;font:inherit;margin:4px 0 12px;min-height:44px}
details{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 18px;margin-bottom:10px}summary{cursor:pointer;font-weight:600}
footer{background:var(--card);border-top:2px solid var(--red);margin-top:40px}footer .wrap{display:flex;flex-wrap:wrap;gap:30px;justify-content:space-between;color:var(--muted)}footer a{display:block;text-decoration:none;padding:3px 0}footer a:hover{color:var(--red)}
@media(max-width:900px){.hero .wrap{grid-template-columns:1fr;padding-bottom:110px}.bar nav{display:none}.burger{display:block}.mc .box{grid-template-columns:1fr}.btn.ghost{margin:10px 0 0}}
</style></head>
<body><header class="bar"><div class="in"><a class="brand" href="/"><img src="/logo.jpg" alt="Logo FC Vacresse">FC VACRESSE</a>
<nav>{nav.map(([h,l]) => <a href={h} class={on(h)}>{l}</a>)}</nav>
<details class="burger" style="background:none;border:0;padding:0"><summary>Menu</summary><nav>{nav.map(([h,l]) => <a href={h}>{l}</a>)}</nav></details></div></header>
<slot />
<footer><div class="wrap"><div><b style="color:var(--ink)">{club.full}</b><br>{club.address}<br>{club.email}</div>
<div>{nav.map(([h,l]) => <a href={h}>{l}</a>)}</div><div><a href={club.rbfa}>Classements RBFA</a><a href="/contact">Sponsoring</a><a href="/faq">FAQ</a></div></div></footer></body></html>
