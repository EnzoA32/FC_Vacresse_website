---
import Base from '../../layouts/Base.astro';
import { teams } from '../../lib/data.js';
---
<Base title="Équipes" description="Les 15 équipes du FC Vacresse."><h1>Équipes</h1>
<div class="grid">{teams.map(t => <a class="card" href={`/equipes/${t.slug}`} style="text-decoration:none"><b>{t.name}</b></a>)}</div></Base>
