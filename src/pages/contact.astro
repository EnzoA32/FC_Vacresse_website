---
import Base from '../layouts/Base.astro';
import { contactSubjects, club } from '../lib/data.js';
---
<Base title="Contact"><h1>Contact</h1><p class="muted">{club.email} · {club.address}</p>
<form method="POST" action="https://api.web3forms.com/submit">
<input type="hidden" name="access_key" value="VOTRE_CLE_WEB3FORMS"><input type="checkbox" name="botcheck" style="display:none">
<label>Prénom<input name="prenom" required></label><label>Nom<input name="nom" required></label>
<label>E-mail<input type="email" name="email" required></label><label>Téléphone<input name="tel"></label>
<label>Sujet<select name="sujet">{contactSubjects.map(s => <option>{s}</option>)}</select></label>
<label>Message<textarea name="message" rows="5" required></textarea></label>
<button class="btn" type="submit">Envoyer</button></form></Base>
